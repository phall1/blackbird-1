#!/bin/sh
# Install/update a local source generation; no network or account mutation.
set -eu
blackbird_source=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
blackbird_prefix=${HOME:?HOME must be set}/.local
blackbird_jobs=6
blackbird_cmake=${CMAKE:-cmake}
blackbird_action=install
blackbird_rollback_target=''
blackbird_keep=3
blackbird_set_action() {
  if [ "$blackbird_action" != install ]; then
    printf 'Choose at most one of --list, --rollback, or --prune.\n' >&2
    exit 2
  fi
  blackbird_action=$1
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --prefix|--source|--jobs|--keep)
      [ "$#" -ge 2 ] || { printf 'Missing value for %s\n' "$1" >&2; exit 2; }
      case "$1" in
        --prefix) blackbird_prefix=$2 ;;
        --source) blackbird_source=$2 ;;
        --jobs) blackbird_jobs=$2 ;;
        --keep) blackbird_keep=$2 ;;
      esac
      shift 2 ;;
    --update) shift ;;
    --list)
      blackbird_set_action list
      shift ;;
    --rollback)
      blackbird_set_action rollback
      if [ "$#" -ge 2 ]; then
        case "$2" in
          -*) ;;
          *) blackbird_rollback_target=$2; shift ;;
        esac
      fi
      shift ;;
    --prune)
      blackbird_set_action prune
      shift ;;
    --help)
      printf 'Usage:\n  install-blackbird [--update] [--prefix DIR] [--source CHECKOUT] [--jobs N]\n  install-blackbird --list [--prefix DIR]\n  install-blackbird --rollback [GENERATION] [--prefix DIR]\n  install-blackbird --prune [--keep N] [--prefix DIR]\nBuild, inspect, roll back, or prune local Blackbird generations. Default prefix: ~/.local.\n'
      exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
done
case "$blackbird_jobs" in ''|*[!0-9]*|0) printf 'Jobs must be a positive integer.\n' >&2; exit 2 ;; esac
case "$blackbird_keep" in ''|*[!0-9]*|0) printf 'Keep count must be a positive integer.\n' >&2; exit 2 ;; esac
# Replace a symlink to a directory atomically, choosing the flag by mv flavour
# rather than OS: GNU mv (Linux, and macOS with Homebrew coreutils on PATH)
# spells it -T, BSD mv spells it -h.
blackbird_replace_symlink() {
  if mv --version >/dev/null 2>&1; then
    mv -fT -- "$1" "$2"
  else
    mv -fh -- "$1" "$2"
  fi
}
blackbird_atomic_switch() {
  blackbird_switch_target=$1
  blackbird_switch_link=$blackbird_home/.current-$$
  rm -f -- "$blackbird_switch_link"
  ln -s -- "$blackbird_switch_target" "$blackbird_switch_link"
  blackbird_replace_symlink "$blackbird_switch_link" "$blackbird_home/current"
}
blackbird_manifest_field() {
  if [ -f "$1/MANIFEST" ]; then
    sed -n "s/^$2=//p" "$1/MANIFEST" | head -n 1
  fi
}
if [ "$blackbird_action" != install ]; then
  if [ ! -d "$blackbird_prefix" ]; then
    printf 'Install prefix not found: %s\n' "$blackbird_prefix" >&2
    exit 1
  fi
  blackbird_prefix=$(CDPATH= cd -- "$blackbird_prefix" && pwd -P)
  blackbird_home=$blackbird_prefix/lib/blackbird
  if [ ! -d "$blackbird_home/releases" ]; then
    printf 'No installed releases under %s\n' "$blackbird_home/releases" >&2
    exit 1
  fi
  blackbird_current=''
  if [ -L "$blackbird_home/current" ]; then
    blackbird_current=$(readlink "$blackbird_home/current" 2>/dev/null || :)
    if [ -n "$blackbird_current" ]; then
      blackbird_current=$(basename -- "$blackbird_current")
    fi
  elif [ -e "$blackbird_home/current" ]; then
    printf 'Refusing to operate on non-symlink: %s/current\n' "$blackbird_home" >&2
    exit 1
  fi
  if [ "$blackbird_action" = list ]; then
    blackbird_found=0
    for blackbird_gen in $(CDPATH= cd -- "$blackbird_home/releases" && ls -1dt generation-* 2>/dev/null || :); do
      [ -d "$blackbird_home/releases/$blackbird_gen" ] || continue
      blackbird_found=1
      blackbird_mark=' '
      if [ "$blackbird_gen" = "$blackbird_current" ]; then blackbird_mark='*'; fi
      blackbird_ver=$(blackbird_manifest_field "$blackbird_home/releases/$blackbird_gen" version)
      blackbird_at=$(blackbird_manifest_field "$blackbird_home/releases/$blackbird_gen" installed_at)
      [ -n "$blackbird_ver" ] || blackbird_ver='legacy'
      [ -n "$blackbird_at" ] || blackbird_at='unknown'
      printf '%s %s\t%s\t%s\n' "$blackbird_mark" "$blackbird_gen" "$blackbird_at" "$blackbird_ver"
    done
    if [ "$blackbird_found" -eq 0 ]; then
      printf 'No generations installed under %s/releases.\n' "$blackbird_home"
    fi
    exit 0
  fi
  mkdir -- "$blackbird_home/install.lock" 2>/dev/null || {
    printf 'Another install holds %s/install.lock (remove only after that installer exits).\n' "$blackbird_home" >&2
    exit 1
  }
  blackbird_mgmt_cleanup() {
    rm -f -- "$blackbird_home/.current-$$"
    rmdir -- "$blackbird_home/install.lock" 2>/dev/null || :
  }
  trap blackbird_mgmt_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  if [ "$blackbird_action" = rollback ]; then
    if [ -n "$blackbird_rollback_target" ]; then
      case "$blackbird_rollback_target" in
        "$blackbird_home/releases/"*)
          blackbird_rollback_target=${blackbird_rollback_target#"$blackbird_home/releases/"} ;;
      esac
      case "$blackbird_rollback_target" in
        ''|*/*|*..*)
          printf 'Invalid generation name: %s\n' "$blackbird_rollback_target" >&2
          exit 2 ;;
        generation-*) ;;
        *)
          printf 'Invalid generation name: %s\n' "$blackbird_rollback_target" >&2
          exit 2 ;;
      esac
      blackbird_target_dir=$blackbird_home/releases/$blackbird_rollback_target
    else
      blackbird_target_dir=''
      for blackbird_gen in $(CDPATH= cd -- "$blackbird_home/releases" && ls -1dt generation-* 2>/dev/null || :); do
        if [ "$blackbird_gen" = "$blackbird_current" ]; then continue; fi
        if [ -x "$blackbird_home/releases/$blackbird_gen/scripts/blackbird" ]; then
          blackbird_target_dir=$blackbird_home/releases/$blackbird_gen
          break
        fi
      done
      if [ -z "$blackbird_target_dir" ]; then
        printf 'No previous generation available to roll back to under %s/releases.\n' "$blackbird_home" >&2
        exit 1
      fi
    fi
    if [ ! -d "$blackbird_target_dir" ] || [ ! -x "$blackbird_target_dir/scripts/blackbird" ]; then
      printf 'Generation is missing or incomplete: %s\n' "$blackbird_target_dir" >&2
      exit 1
    fi
    blackbird_atomic_switch "$blackbird_target_dir"
    blackbird_ver=$(blackbird_manifest_field "$blackbird_target_dir" version)
    [ -n "$blackbird_ver" ] || blackbird_ver='legacy'
    printf 'Rolled back Blackbird: %s/bin/blackbird\nVersion: %s\nGeneration: %s\n' \
      "$blackbird_prefix" "$blackbird_ver" "$blackbird_target_dir"
    exit 0
  fi
  if [ "$blackbird_action" = prune ]; then
    blackbird_kept=0
    blackbird_pruned=0
    blackbird_keep_budget=$blackbird_keep
    if [ -n "$blackbird_current" ] && [ -d "$blackbird_home/releases/$blackbird_current" ]; then
      blackbird_kept=1
    fi
    for blackbird_gen in $(CDPATH= cd -- "$blackbird_home/releases" && ls -1dt generation-* 2>/dev/null || :); do
      [ -d "$blackbird_home/releases/$blackbird_gen" ] || continue
      if [ "$blackbird_gen" = "$blackbird_current" ]; then
        continue
      fi
      if [ "$blackbird_kept" -lt "$blackbird_keep_budget" ]; then
        blackbird_kept=$((blackbird_kept + 1))
      else
        rm -rf -- "$blackbird_home/releases/$blackbird_gen"
        blackbird_pruned=$((blackbird_pruned + 1))
      fi
    done
    printf 'Pruned %d generation(s); kept %d under %s/releases.\n' \
      "$blackbird_pruned" "$blackbird_kept" "$blackbird_home"
    exit 0
  fi
fi
blackbird_source=$(CDPATH= cd -- "$blackbird_source" && pwd -P)
for blackbird_required in CMakeLists.txt CMakePresets.json scripts/blackbird programs/turn.lua programs/instruments/results.lua assets/sr71.png profiles/providers/conservative.lua; do
  [ -f "$blackbird_source/$blackbird_required" ] || { printf 'Incomplete source: %s\n' "$blackbird_required" >&2; exit 1; }
done
mkdir -p -- "$blackbird_prefix"
blackbird_prefix=$(CDPATH= cd -- "$blackbird_prefix" && pwd -P)
blackbird_home=$blackbird_prefix/lib/blackbird
mkdir -p -- "$blackbird_home/releases" "$blackbird_prefix/bin"
# A same-prefix concurrent installer must not replace this transaction's pointer.
mkdir -- "$blackbird_home/install.lock" 2>/dev/null || {
  printf 'Another install holds %s/install.lock (remove only after that installer exits).\n' "$blackbird_home" >&2
  exit 1
}
blackbird_generation=''
blackbird_link=''
blackbird_launcher=''
blackbird_previous_launcher=''
blackbird_launcher_published=false
blackbird_activated=false
blackbird_cleanup() {
  if [ -n "$blackbird_link" ]; then rm -f -- "$blackbird_link"; fi
  if [ -n "$blackbird_launcher" ]; then rm -f -- "$blackbird_launcher"; fi
  # A signal after rename must never remove the now-active generation.
  if [ -n "$blackbird_generation" ] &&
     [ "$(readlink "$blackbird_home/current" 2>/dev/null || :)" = "$blackbird_generation" ]; then
    blackbird_activated=true
  fi
  if ! "$blackbird_activated"; then
    if "$blackbird_launcher_published"; then
      if [ -n "$blackbird_previous_launcher" ]; then
        mv -f -- "$blackbird_previous_launcher" "$blackbird_prefix/bin/blackbird"
        blackbird_previous_launcher=''
      else
        rm -f -- "$blackbird_prefix/bin/blackbird"
      fi
    fi
    if [ -n "$blackbird_generation" ]; then rm -rf -- "$blackbird_generation"; fi
  fi
  if [ -n "$blackbird_previous_launcher" ]; then rm -f -- "$blackbird_previous_launcher"; fi
  rmdir -- "$blackbird_home/install.lock"
}
trap blackbird_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [ -e "$blackbird_prefix/bin/blackbird" ] || [ -L "$blackbird_prefix/bin/blackbird" ]; then
  if [ -L "$blackbird_prefix/bin/blackbird" ] ||
     [ "$(sed -n '2p' "$blackbird_prefix/bin/blackbird")" != '# blackbird managed launcher v1' ]; then
    printf 'Refusing to replace unrelated launcher: %s/bin/blackbird\n' "$blackbird_prefix" >&2
    exit 1
  fi
fi
if [ -e "$blackbird_home/current" ] && [ ! -L "$blackbird_home/current" ]; then
  printf 'Refusing to replace non-symlink: %s/current\n' "$blackbird_home" >&2
  exit 1
fi
blackbird_generation=$(mktemp -d "$blackbird_home/releases/generation-XXXXXXXX")
mkdir -p -- "$blackbird_generation/bin" "$blackbird_generation/share/blackbird" "$blackbird_generation/scripts" "$blackbird_generation/.build"
cp -R -- "$blackbird_source/programs" "$blackbird_source/assets" "$blackbird_source/profiles" "$blackbird_generation/share/blackbird/"
cp -- "$blackbird_source/scripts/blackbird" "$blackbird_generation/scripts/blackbird"
chmod 755 "$blackbird_generation/scripts/blackbird"
# Build into a scratch directory, copy the lean production binaries into bin/,
# and discard intermediate object/library trees before activation.
"$blackbird_cmake" --preset release -S "$blackbird_source" -B "$blackbird_generation/.build" \
  "-DBLACKBIRD_RESOURCE_ROOT=$blackbird_generation/share/blackbird"
"$blackbird_cmake" --build "$blackbird_generation/.build" --parallel "$blackbird_jobs" \
  --target blackbird blackbird-candidate blackbird-auth blackbird-workflow blackbird-colleague \
  blackbird-resource-sampler blackbird-raw-reader blackbird-token-usage
for blackbird_tool in blackbird blackbird-candidate blackbird-auth blackbird-workflow blackbird-colleague blackbird-job-runner blackbird-archive blackbird-resource-sampler blackbird-raw-reader blackbird-token-usage; do
  [ -x "$blackbird_generation/.build/$blackbird_tool" ] || { printf 'Missing executable: %s\n' "$blackbird_tool" >&2; exit 1; }
  cp -p -- "$blackbird_generation/.build/$blackbird_tool" "$blackbird_generation/bin/$blackbird_tool"
done
rm -rf -- "$blackbird_generation/.build"
# On macOS, verify installed binaries do not depend on Homebrew/local dylibs.
if [ "$(uname -s)" = Darwin ] && command -v otool >/dev/null 2>&1; then
  for blackbird_tool in blackbird blackbird-candidate blackbird-auth blackbird-workflow blackbird-colleague blackbird-job-runner blackbird-archive blackbird-resource-sampler blackbird-raw-reader blackbird-token-usage; do
    blackbird_dylibs=$(otool -L "$blackbird_generation/bin/$blackbird_tool" 2>/dev/null || :)
    case "$blackbird_dylibs" in
      */opt/homebrew/*|*/usr/local/*)
        printf 'Refusing non-self-contained binary (%s) with external dylib dependency:\n%s\n' "$blackbird_tool" "$blackbird_dylibs" >&2
        exit 1 ;;
      */nix/store/*) blackbird_nix_linked=true ;;
    esac
  done
fi
if [ "${blackbird_nix_linked:-false}" = true ]; then
  printf 'Note: this build links Nix store libraries, which nix-collect-garbage may remove.\nFor a GC-rooted install use: nix profile install %s\n' "$blackbird_source" >&2
fi
# All smoke state is private and offline. Do not consult the operator's accounts.
mkdir -m 700 "$blackbird_generation/.smoke"
blackbird_version=$("$blackbird_generation/bin/blackbird" --version)
case "$blackbird_version" in
  blackbird\ *) ;;
  *) printf 'Unexpected --version output: %s\n' "$blackbird_version" >&2; exit 1 ;;
esac
"$blackbird_generation/bin/blackbird" --help > "$blackbird_generation/.smoke/help"
BLACKBIRD_AUTH_HOME="$blackbird_generation/.smoke/auth" \
  "$blackbird_generation/bin/blackbird" auth providers > "$blackbird_generation/.smoke/providers"
cat > "$blackbird_generation/.smoke/local.lua" <<'LUA'
local result = blackbird.call('exec', {argv={'/bin/sh', '-c', 'exit 0'}, pty=true})
assert(result.exit_code == 0, 'Installed PTY helper failed')
print('BLACKBIRD_INSTALL_SMOKE')
LUA
if BLACKBIRD_AUTH_HOME="$blackbird_generation/.smoke/auth" \
  "$blackbird_generation/bin/blackbird" --plain \
  --session "$blackbird_generation/.smoke/session" \
  --workflow "$blackbird_generation/.smoke/local.lua" --once offline-install-smoke \
  > "$blackbird_generation/.smoke/local-output"; then
  :
else
  cat "$blackbird_generation/.smoke/local-output" >&2
  exit 1
fi
case "$(cat "$blackbird_generation/.smoke/local-output")" in
  *BLACKBIRD_INSTALL_SMOKE*) ;;
  *) printf 'Installed local workflow smoke did not complete.\n' >&2; exit 1 ;;
esac
rm -rf -- "$blackbird_generation/.smoke"
blackbird_commit=$(git -C "$blackbird_source" rev-parse --short=12 HEAD 2>/dev/null || printf unknown)
{
  printf 'version=%s\n' "$blackbird_version"
  printf 'commit=%s\n' "$blackbird_commit"
  printf 'source=%s\n' "$blackbird_source"
  printf 'installed_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$blackbird_generation/MANIFEST"
# A quoted absolute prefix handles spaces and shell metacharacters literally.
blackbird_quoted_home=$(printf '%s' "$blackbird_home" | sed "s/'/'\\\\''/g")
blackbird_launcher=$(mktemp "$blackbird_prefix/bin/.blackbird-XXXXXXXX")
{
  printf '#!/bin/sh\n# blackbird managed launcher v1\nset -eu\n'
  printf "blackbird_install_home='%s'\n" "$blackbird_quoted_home"
  cat <<'LAUNCHER'
blackbird_release=$(CDPATH= cd -- "$blackbird_install_home/current" && pwd -P)
BLACKBIRD_SPRITE_ASSET=${BLACKBIRD_SPRITE_ASSET:-"$blackbird_release/share/blackbird/assets/sr71.png"}
export BLACKBIRD_SPRITE_ASSET
exec "$blackbird_release/scripts/blackbird" "$@"
LAUNCHER
} > "$blackbird_launcher"
chmod 755 "$blackbird_launcher"
# Publish the stable launcher before the final generation switch. On update it
# remains compatible with the old current pointer if the final rename fails.
if [ -f "$blackbird_prefix/bin/blackbird" ]; then
  blackbird_previous_launcher=$(mktemp "$blackbird_prefix/bin/.blackbird-previous-XXXXXXXX")
  cp -p -- "$blackbird_prefix/bin/blackbird" "$blackbird_previous_launcher"
fi
# Set before rename so signal cleanup can restore either side of publication.
blackbird_launcher_published=true
mv -f -- "$blackbird_launcher" "$blackbird_prefix/bin/blackbird"
blackbird_launcher=''
blackbird_link=$blackbird_home/.current-$$
ln -s -- "$blackbird_generation" "$blackbird_link"
blackbird_replace_symlink "$blackbird_link" "$blackbird_home/current"
blackbird_link=''
blackbird_activated=true
printf 'Installed Blackbird: %s/bin/blackbird\nVersion: %s\nGeneration: %s\nUpdate: %s/scripts/install-blackbird --update --prefix %s\n' \
  "$blackbird_prefix" "$blackbird_version" "$blackbird_generation" "$blackbird_source" "$blackbird_prefix"
case ":${PATH:-}:" in
  *":$blackbird_prefix/bin:"*) ;;
  *) printf 'Add %s/bin to PATH to invoke blackbird directly.\n' "$blackbird_prefix" ;;
esac
